{
  "description": "OpenMonkey for Safari — a free, open, Tampermonkey-compatible Safari userscript manager.",
  "devDependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0",
    "@types/node": "^22.14.0",
    "codemirror": "^6.0.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "license": "MPL-2.0",
  "name": "openmonkey-safari",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.extension.json && node extension/build.mjs",
    "dev": "node extension/build.mjs --watch",
    "test": "tsc -p tsconfig.json && node --test dist-test/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "0.5.3"
}
